# Copy to server/.env for local use, or paste these into your host's
# environment variables. Never commit the real .env.

# ---------- database ----------
# Unset  -> a local SQLite file (zero setup, but most free hosts wipe the disk)
# Set    -> Postgres (Neon, Supabase, Railway, Render...). Recommended for
#           anything public, because it survives restarts.
DATABASE_URL=

# Only used by the SQLite path. Point it at a mounted volume to persist:
#   DATABASE_PATH=/data/anvil.db
DATABASE_PATH=

# ---------- auth ----------
# REQUIRED in production — the server refuses to boot without it.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The shared password for the seeded demo accounts, admin included.
# REQUIRED in production — the server refuses to boot without one, or with the
# public default "anvil1234". 8+ characters with a letter and a number.
# Locally it can stay blank (it falls back to anvil1234).
DEMO_PASSWORD=

# ---------- resume scan (optional) ----------
# Unset -> the offline keyword matcher, which labels itself as such.
ANTHROPIC_API_KEY=
# Override if the default model id has been retired.
# https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=
# Site-wide cap on AI scans per hour; past it, scans use the keyword matcher.
AI_SCANS_PER_HOUR=60

# ---------- job feeds (optional) ----------
# Unset -> employer-posted jobs only.
# Adzuna: free tier, self-serve key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# CareerOneStop (US Dept of Labor): free, register at
# https://www.careeronestop.org/Developers/WebAPI/registration.aspx
COS_USER_ID=
COS_TOKEN=
# Where and how far to search when importing.
FEED_LOCATION=Raleigh, NC
FEED_RADIUS_MILES=50
FEED_PER_QUERY=5
# Imported listings not returned by a sync for this many days are removed.
FEED_MAX_AGE_DAYS=30

# ---------- server ----------
PORT=
# Only if you host the frontend on a different site: a comma-separated list of
# origins allowed to call the API with cookies. Leave blank for the normal
# one-service deployment.
CORS_ORIGIN=
